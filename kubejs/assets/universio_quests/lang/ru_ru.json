  "lanminecraft.universio.quests.6lact_ir_primal_age.582ca63170be": "Алтарь забытых рун",
  "lanminecraft.universio.quests.6lact_ir_primal_age.448b5e473ac7": "Сделай &a[Бассейн маны]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.75d38d063620": "Купаться нельзя",
  "lanminecraft.universio.quests.6lact_ir_primal_age.02068bd37aaf": "Сделай &a[Лепестковый аптекарь]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.0886c6ded900": "Рецепт красоты",
  "lanminecraft.universio.quests.6lact_ir_primal_age.737c88fbd14c": "Сделай &a[Чистую ромашку]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.f62aece4f53d": "Чистота на все 100%",
  "lanminecraft.universio.quests.6lact_ir_primal_age.5c4a16ee0e5c": "В рецепте показано:",
  "lanminecraft.universio.quests.6lact_ir_primal_age.1f7b94fd988b": "&a+&r Блок нужно поставить под бассейном маны",
  "lanminecraft.universio.quests.6lact_ir_primal_age.77042860c4a8": "&a+&r Предметы нужно бросить в бассейн маны",
  "lanminecraft.universio.quests.6lact_ir_primal_age.043757464aaa": "Добудь &a[Порошок маны]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.ada5f50b3c1f": "Магия в порошке",
  "lanminecraft.universio.quests.6lact_ir_primal_age.f516e3d28b33": "&a[Глина]&r встречается при добыче руды",
  "lanminecraft.universio.quests.6lact_ir_primal_age.0b0219f7b99a": "Добудь &a[Комок глины]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.1a6b2db70bb7": "Комок грязи",
  "lanminecraft.universio.quests.6lact_ir_primal_age.28145c6bd61f": "Сделай &a[Руну воды]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.0e30fe4f4c7d": "&1Вода",
  "lanminecraft.universio.quests.6lact_ir_primal_age.cbb494359c6e": "Сделай &a[Руну огня]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.7d2c6d6ab5e4": "&4Огонь",
  "lanminecraft.universio.quests.6lact_ir_primal_age.d8af6cedb6eb": "Сделай &a[Руну земли]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.fb77e416408a": "&aЗемля",
  "lanminecraft.universio.quests.6lact_ir_primal_age.1591fb0a8f71": "Сделай &a[Руну воздуха]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.3277ad51211c": "&oВоздух",
  "lanminecraft.universio.quests.6lact_ir_primal_age.a1cab30b5dbf": "Сделай &a[Руну маны]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.d84965799610": "&5Мана",
  "lanminecraft.universio.quests.6lact_ir_primal_age.5efe015c8601": "Добудь любой &a[Лепесток из Botania]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.9e3bba955a31": "Любой предмет с тегом #botania:petals",
  "lanminecraft.universio.quests.6lact_ir_primal_age.e04c91ef5674": "Волшебные лепестки",
  "lanminecraft.universio.quests.6lact_ir_primal_age.81bba6a25ff7": "Сделай &a[Компостницу]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.006f8db782df": "Компостируем и отдыхаем",
  "lanminecraft.universio.quests.6lact_ir_primal_age.cd8b385c5704": "Сделай любую &a[Деревянную плиту]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.1db3e6dc0208": "Любой предмет с тегом #minecraft:wooden_slabs",
  "lanminecraft.universio.quests.6lact_ir_primal_age.0999debd9929": "Половинка четвертинки",
  "lanminecraft.universio.quests.6lact_ir_primal_age.6d5113af7609": "Добудь &a[Костную муку]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.97a72147431b": "Несъедобно!",
  "lanminecraft.universio.quests.6lact_ir_primal_age.ea475e96e256": "Сделай &a[Керамические ножницы]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.8a986788761a": "Отрежь всё лишнее!",
  "lanminecraft.universio.quests.6lact_ir_primal_age.fe7975720edf": "Сделай &a[Пламя Края]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.c95e3e88d74f": "Пока сойдёт и так",
  "lanminecraft.universio.quests.6lact_ir_primal_age.810aa480035f": "Добудь &a[Бревно живого дерева]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.672fbb2ece04": "Оно живое!",
  "lanminecraft.universio.quests.6lact_ir_primal_age.f0201fd1ce62": "\\n           &a+&r Открывает &5[Индустриальную эпоху]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.a8f0fa68426b": "Сделай &a[Свиток трансмутации]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.8ec911e87e52": "Свиток всех знаний",
  "lanminecraft.universio.quests.6lact_ir_primal_age.d4095ecfae2c": "Сделай &a[Котёл]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.4497cd0802a2": "Просто котёл",
  "lanminecraft.universio.quests.6lact_ir_primal_age.84f6373073d8": "Сделай &a[Распространитель маны]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.29e3742f0cb9": "Мана во все стороны",
  "lanminecraft.universio.quests.6lact_ir_primal_age.cfceaaa0feec": "Сделай &a[Костёр]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.56864ed13798": "Огонёк в ночи",
  "lanminecraft.universio.quests.6lact_ir_primal_age.d207133b7ce9": "Сделай &a[Ботанический горшок с воронкой]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.6eb8828fe8a9": "Горшок особого назначения!",
  "lanminecraft.universio.quests.6lact_ir_primal_age.97c7b2899890": "Добудь &a[Камень]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.cb390ef29896": "Камень поглаже",
  "lanminecraft.universio.quests.6lact_ir_primal_age.d892fa72fe15": "Добудь &a[Гладкий камень]",
  "lanminecraft.universio.quests.6lact_ir_primal_age.a9c121025ab1": "Гладко сработано",
  "lanminecraft.universio.quests.6lact_ir_primal_age.acf2e46913d3": "&a&lАкт Альфа [α]:&r Первобытная эпоха",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.62fb7a7beb87": "&a+&r Чтобы попасть в &a[Нижний мир]&r, копайте вниз в &a[Чистилище]&r до &bY = -62&r. Как только спуститесь ниже, вас перенесёт в другое измерение.",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.555729817e4e": "Посетите &a[Нижний мир]",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.021e3d14921b": "Вот теперь ад",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.82375417b61b": "&a+&r Как призвать:",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.224ee80a5a3d": "Завершите задание на призыв",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.76cf783b0d16": "&c*&4 Дайте Иссушающей буре пройти все стадии развития. НЕ УБИВАЙТЕ ЕЁ СРАЗУ.",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.46d0ff33bea3": "Добудьте &a[звезду Иссушающей бури]&r, победив &a[Иссушающую бурю]&r",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.df92cbc25b70": "На пике иссушения",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.a371c26f1829": "Добудьте &a[яйцо дракона]&r, победив &a[дракона Края]&r",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.e9bb7a0def58": "Яблочный пирог, первое издание",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.ddf2e681c647": "Хорошая игра, вы победили!",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.0ecac1a8e4a7": "Конец",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.fd78e177247e": "&c*&4 Будьте осторожны при установке: УНИЧТОЖИТЬ БЛОК УЖЕ НЕ ПОЛУЧИТСЯ.",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.e4cc7360b938": "&c*&4 Иссушающая буря появится в Крае. Наберитесь терпения.",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.9407ce3856a9": "Призовите &5[ИССУШАЮЩУЮ БУРЮ]",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.ef351cf2ce67": "Сдайте &a[командный блок]&r, чтобы призвать Иссушающую бурю",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.b81588c46bda": "Всемогущее создание",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.cc91d548e19e": "\\n&a+&r Открывает &5[Цифровую эпоху]",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.d513c9b0b5a5": "Прочтите!",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.3421d0f1886b": "Первобытная эпоха",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.af1f3cffdf41": "&a[Цифровая эпоха]",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.df4162e2ee77": "&a+&r Чтобы попасть в &a[Край]&r, копайте вниз в &a[Нижнем мире]&r до &bY = 2&r. Как только спуститесь ниже, вас перенесёт в другое измерение.",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.4e7a56b42a42": "Посетите &a[Край]",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.e1dbdd320228": "Это конец?",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.5f9004aeb063": "&c*&4 Убедитесь, что маны хватит на создание предметов на наземной агломерационной плите из Botania, иначе предметы исчезнут!",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.4ae2e4e76ca5": "Прочтите!",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.d0de13ef512d": "ПРОЧТИТЕ!",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.93f606b31ca5": "&4Внимание!",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.06406493fc9d": "У вас есть выбор: продолжить основной путь и убить Иссушающую бурю или пойти другой дорогой и пропустить битву.",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.69e3e4a95c88": "Решать вам.",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.a0bebe697b35": "Без ожидания",
  "lanminecraft.universio.quests.6lact_ivr_digital_age.6aa1f9855bc4": "&a&lАкт Гамма [γ]:&r Цифровая эпоха",
  "lanminecraft.universio.quests.act_new_universe.80acd0c629df": "Поставьте &a[блок Земли]&r и нажмите по нему правой кнопкой мыши, чтобы отправиться на &a[Землю]&r.",
  "lanminecraft.universio.quests.act_new_universe.29bea225abd2": "Создайте &a[Землю]&r",
  "lanminecraft.universio.quests.act_new_universe.091789c174f9": "Дом, милый дом?",
  "lanminecraft.universio.quests.act_new_universe.b1477ad56cfb": "&a+&r Нажмите правую кнопку мыши, чтобы &a[гравитация] &aвключилась&r или &4выключилась&r для вас.\\n\\n&a+&r Зажмите Shift и нажмите правую кнопку мыши, чтобы настроить гравитацию у ближайших существ.",
  "lanminecraft.universio.quests.act_new_universe.8b0618786d91": "Овладейте &a[гравитацией]&r",
  "lanminecraft.universio.quests.act_new_universe.c87c1b70e0fd": "Фундаментальные силы",
  "lanminecraft.universio.quests.act_new_universe.1d3a6e63f0f7": "Добудьте &a[литий]",
  "lanminecraft.universio.quests.act_new_universe.e388535dd5a2": "Добудьте &a[бериллий]",
  "lanminecraft.universio.quests.act_new_universe.11482c50bb3c": "Добудьте &a[бор]",
  "lanminecraft.universio.quests.act_new_universe.96e1f560fe03": "Добудьте &a[гелий]",
  "lanminecraft.universio.quests.act_new_universe.af849e35ae91": "&a+&r Нажмите правую кнопку мыши, чтобы вызвать взрыв сверхновой.",
  "lanminecraft.universio.quests.act_new_universe.904e5b80fbb6": "Создайте &a[звезду]&r",
  "lanminecraft.universio.quests.act_new_universe.cb8986a5b2ab": "Не совсем в форме звезды",
  "lanminecraft.universio.quests.act_new_universe.f48c54e79aa0": "&a+&r Нажмите правую кнопку мыши, чтобы открыть новые элементы.",
  "lanminecraft.universio.quests.act_new_universe.c07cc882859e": "Добудьте &a[космическую пыль]",
  "lanminecraft.universio.quests.act_new_universe.97a3008e81b8": "Пыль, да не простая",
  "lanminecraft.universio.quests.act_new_universe.2d47b0ff378c": "Добудьте &a[водород]&r",
  "lanminecraft.universio.quests.act_new_universe.c6628b1c0164": "Создайте &a[атом]",
  "lanminecraft.universio.quests.act_new_universe.272cfb0e4fa3": "Возьмите в руку &a[философский камень]&r. Чтобы открыть сетку крафта, нажмите &a[C]&r (клавиша по умолчанию).",
  "lanminecraft.universio.quests.act_new_universe.8d5590dab0d5": "&o&4Нам нужно поговорить, но чуть позже. А пока приступай.",
  "lanminecraft.universio.quests.act_new_universe.d513c9b0b5a5": "Прочтите!",
  "lanminecraft.universio.quests.act_new_universe.000b821603b6": "Крафт",
  "lanminecraft.universio.quests.act_new_universe.de45e6650d6b": "Добудьте &a[электрон]",
  "lanminecraft.universio.quests.act_new_universe.2b8d70ae4237": "Электроны",
  "lanminecraft.universio.quests.act_new_universe.ceaed63c7660": "Чтобы получить &a[блок всего]&r, нажмите правой кнопкой мыши по &a[блоку небытия]&r, держа в руке &5[сборщик пустоты]&r.",
  "lanminecraft.universio.quests.act_new_universe.af3d015c855d": "Как получить &a[блок всего]",
  "lanminecraft.universio.quests.act_new_universe.ec4f27981792": "Добудьте &a[верхний кварк]",
  "lanminecraft.universio.quests.act_new_universe.7a7c0b0da321": "Верхние кварки",
  "lanminecraft.universio.quests.act_new_universe.ed902d9365a9": "Добудьте &a[глюон]",
  "lanminecraft.universio.quests.act_new_universe.f88f4c6f44f8": "Клей для кварков",
  "lanminecraft.universio.quests.act_new_universe.e80857ceb465": "Добудьте &a[протон]",
  "lanminecraft.universio.quests.act_new_universe.d0315c79ae27": "Протоны",
  "lanminecraft.universio.quests.act_new_universe.24f68a543605": "Чтобы получить &a[глюоны]&r, разные &a[кварки]&r и &a[электроны]&r, добудьте &a[блок небытия]&r с помощью &5[сборщика пустоты]&r.",
  "lanminecraft.universio.quests.act_new_universe.160a0d17092f": "&o&4\\nВот, держи. Тебе это пригодится. Но на частые подачки не рассчитывай.",
  "lanminecraft.universio.quests.act_new_universe.4ce088606641": "Кварки и всё такое",
  "lanminecraft.universio.quests.act_new_universe.704ee3763574": "Добудьте &a[нижние кварки]",
  "lanminecraft.universio.quests.act_new_universe.7b32226f4bc8": "Нижние кварки",
  "lanminecraft.universio.quests.act_new_universe.b26ed79bc694": "Добудьте &a[нейтрон]",
  "lanminecraft.universio.quests.act_new_universe.76dd25b76883": "Нейтроны",
  "lanminecraft.universio.quests.act_new_universe.5a78990f2956": "Что ж, пора раскрыть карты.",
  "lanminecraft.universio.quests.act_new_universe.40caa1608ab6": "&o&4Ты сам на это пошёл. Ты не послушник и никогда не станешь Хранителем. Точка.",
  "lanminecraft.universio.quests.act_new_universe.98723492ccbe": "Это было вступление к Испытаниям. Пройди их, и станешь стражем наших миров.",
  "lanminecraft.universio.quests.act_new_universe.f2f42af02d37": "&o&4Ты откликнулся на зов. Мы ничего не обещали, но у этого есть свои преимущества.",
  "lanminecraft.universio.quests.act_new_universe.5ccf0aed48cf": "За работу. Прежде чем тебе что-то доверят, придётся доказать, на что ты способен.",
  "lanminecraft.universio.quests.act_new_universe.2792c6bc0533": "Прочтите! &5[Сюжет]",
  "lanminecraft.universio.quests.act_new_universe.d136af829ff7": "Мы солгали…",
  "lanminecraft.universio.quests.act_new_universe.17a88427817f": "CC: Новая вселенная",
  "lanminecraft.universio.quests.act_new_universe.41efc32e075a": "&a&lАкт нулевой [0]:&r Новая вселенная",
  "lanminecraft.universio.quests.blpsi_0_act_side_actr_place_holder.72ef66ccd061": "Получите все свитки",
  "lanminecraft.universio.quests.blpsi_0_act_side_actr_place_holder.aab83892a7e8": "&b&lПси ψ[1]:&r Свитки заклинаний",
  "lanminecraft.universio.quests.informatica.c024bf81ec27": "&a+&r Ultimine работает, только если вы держите инструмент.",
  "lanminecraft.universio.quests.informatica.b9652a4b3b2a": "&a+&r Задания со знаком «!» содержат важную информацию. Прочитайте их и отметьте галочкой.",
  "lanminecraft.universio.quests.informatica.3ac997323878": "&a+&r Значение EMC химического элемента равно его атомному номеру. У водорода это 1, у гелия 2 и так далее. EMC соединения складывается из EMC входящих в него элементов.",
  "lanminecraft.universio.quests.informatica.c6fa2432b9dc": "&a+&r Прокручивайте колёсико мыши, чтобы менять масштаб в книге квестов.",
  "lanminecraft.universio.quests.informatica.25a9b421d80c": "&a+&r Взрывы криперов не разрушают блоки, но всё равно могут нанести вам урон.",
  "lanminecraft.universio.quests.informatica.96e9232751c4": "&a+&r Сон ускоряет время, как «Время в бутылке».",
  "lanminecraft.universio.quests.informatica.30f65e746875": "&a+&r Если вам трудно различать текстуры, включите специальный набор ресурсов для лучшей различимости.",
  "lanminecraft.universio.quests.informatica.4ae2e4e76ca5": "Прочтите!",
  "lanminecraft.universio.quests.informatica.1a134db67470": "Важная информация",
  "lanminecraft.universio.quests.informatica.e88945c46997": "Надо мной мерцали звёзды, и на меня снизошло спокойствие. Казалось, целую вечность я блуждал в космосе, бесцельно дрейфуя в пустоте. Но теперь у меня появилась цель.",
  "lanminecraft.universio.quests.informatica.ce4bdf24f372": "В видении мне явились &aХранители&r и поручили создать собственную вселенную, где законы физики и магии сосуществовали бы в полной гармонии. Я понимал, какая это ответственность: от меня зависела судьба бесчисленных мультивселенных.",
  "lanminecraft.universio.quests.informatica.f71978e284ab": "Я принялся за дело. Силой мысли я превращал вихри газов и частиц вокруг себя в строительный материал для нового мира. Я создавал галактики и туманности, тщательно продумывая каждую из них.",
  "lanminecraft.universio.quests.informatica.acf9631a062d": "Время &5сюжета&r",
  "lanminecraft.universio.quests.informatica.e9e509dcd358": "История",
  "lanminecraft.universio.quests.informatica.6a4d8d97a552": "Привет! Меня зовут Crypt1C (Cryptic). Спасибо, что скачали &a«UniversIO»&r и играете в неё. Для меня это очень важно!",
  "lanminecraft.universio.quests.informatica.0bf7f38adc87": "Обо мне",
  "lanminecraft.universio.quests.informatica.4efca0d10c5f": "Об авторе",
  "lanminecraft.universio.quests.informatica.8d8406f7ffd0": "&aПриятной игры!",
  "lanminecraft.universio.quests.informatica.9d9974da4c65": "Вперёд!",
  "lanminecraft.universio.quests.informatica.9ebe423fe3e7": "Всё готово!",
  "lanminecraft.universio.quests.informatica.0c4855562cf7": "&a+&r За выполнение заданий вы получаете монеты. Чем сложнее задание, тем ценнее награда.",
  "lanminecraft.universio.quests.informatica.1bea60303f2e": "&a+&r Монеты нужны для торговли с жителями.",
  "lanminecraft.universio.quests.informatica.90e1ca9f41b2": "&a+&r Нажмите правой кнопкой мыши по монетам, чтобы положить их в кошелёк. Он находится в правом верхнем углу инвентаря.",
  "lanminecraft.universio.quests.informatica.8011a0660fc4": "&a+&r Чем реже предмет, тем он дороже.",
  "lanminecraft.universio.quests.informatica.dcb4a188fbd0": "&a+&r Монеты бывают трёх видов:\\n\\n                    (бронзовые > серебряные > золотые)",
  "lanminecraft.universio.quests.informatica.e953de6f4614": "Гиперпродвинутый универсальный магазин",
  "lanminecraft.universio.quests.informatica.b63e07ecb2a6": "&f&lСправка"
}
