  "lanminecraft.universio.quests.informatica.1bea60303f2e": "&a+&r Coins Are Used For Trading With Villagers",
  "lanminecraft.universio.quests.informatica.90e1ca9f41b2": "&a+&r You Can Right Click the Coins To Store It In Your Personal Money Bag (Found In The Top Right Corner Of The Player's Inventory)",
  "lanminecraft.universio.quests.informatica.8011a0660fc4": "&a+&r The Cost Of Items Is Higher Depending On Its Rarity",
