  "lanminecraft.universio.quests.blpsi_0_act_side_actr_place_holder.aab83892a7e8": "&b&lPsi ψ[1]:&r Hex Scrolls",
  "lanminecraft.universio.quests.informatica.c024bf81ec27": "&a+&r You Can Only Use Ultimine While Holding A Tool",
  "lanminecraft.universio.quests.informatica.b9652a4b3b2a": "&a+&r Quests With An Exclamation Mark Are Checkmark Quests And Contain Important Information So Make Sure To Read Them",
  "lanminecraft.universio.quests.informatica.3ac997323878": "&a+&r Chemicals Have EMC Values Equal To Their Atomic Number i.e Hydrogen has an EMC value of 1, Helium -> 2, Etc... And Based Off Of That Every Compound Has An EMC Value Of Chemicals That Make It",
  "lanminecraft.universio.quests.informatica.c6fa2432b9dc": "&a+&r Use Scroll Wheel To Zoom In/Out Inside The Quest Book",
  "lanminecraft.universio.quests.informatica.25a9b421d80c": "&a+&r Creepers WONT Destroy Blocks When Exploding Howerver They Can Still Hurt You",
  "lanminecraft.universio.quests.informatica.96e9232751c4": "&a+&rSleeping Speeds Time (Like A Time In A Bottle)",
  "lanminecraft.universio.quests.informatica.30f65e746875": "&a+&r If You Are Having A Hard Time With The Textures, You Can Enable The Custom Accessibilty Resource Pack !",
  "lanminecraft.universio.quests.informatica.4ae2e4e76ca5": "Read Me !",
  "lanminecraft.universio.quests.informatica.1a134db67470": "Important Information",
  "lanminecraft.universio.quests.informatica.e88945c46997": "As the stars twinkled above me, I felt a sense of calm wash over me. I had been lost in space for what felt like an eternity, drifting aimlessly through the void. But now, I had a purpose.",
  "lanminecraft.universio.quests.informatica.ce4bdf24f372": "&aThe Keepers&r had appeared to me in a vision, tasking me with creating my own universe where the laws of physics and laws of magic co-exist in perfect harmony. I was filled with a sense of responsibility, knowing that the fate of countless multiverses rested on my shoulders.",
  "lanminecraft.universio.quests.informatica.f71978e284ab": "I set to work, using the power of my mind to shape the swirling gases and particles around me into the building blocks of a new world. I crafted galaxies and nebulae, designing each one with care and precision.",
  "lanminecraft.universio.quests.informatica.acf9631a062d": "&5LORE&r Time",
  "lanminecraft.universio.quests.informatica.e9e509dcd358": "Story",
  "lanminecraft.universio.quests.informatica.6a4d8d97a552": "Hi My Name Is Crypt1C (Cryptic) And Thanks For Downloading And Playing &a\"UniversIO\"&r It Means So Much To Me !",
  "lanminecraft.universio.quests.informatica.0bf7f38adc87": "About Me",
